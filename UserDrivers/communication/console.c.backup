extern UART_HandleTypeDef huart1;
const char* prompt = "\r\n\033[36m[Falkra >>] \033[0m";

// External TCP client queue from main_cpp.cpp
extern QueueHandle_t tcpClientQueue;
#define TCP_MSG_MAX_LEN 256

// External UserConfig instance (initialized in main)
extern userconfig_t* g_userConfig;

extern const char* rtc_get_time_str();
extern void rtc_set_time(uint8_t hour, uint8_t minute, uint8_t second);
extern void rtc_set_date(uint8_t weekday, uint8_t month, uint8_t date, uint8_t year); 

 char log_buffer[128];
static size_t log_pos = 0;

void uart_handle_CONSOLE(uint8_t byte) {
    switch (byte) {
        case '\r':
        case '\n':
            log_buffer[log_pos] = '\0';
            if (log_pos > 0) { 

                    if (strncasecmp(log_buffer, "jumpTobootloader", strlen("jumpTobootloader")) == 0) {
                        const char* msg = "\r\n[INFO] Jumping to bootloader...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        osDelay(100);
                        qspiFlash_set_fuse();
                        NVIC_SystemReset();
                    }

                    if(strncasecmp(log_buffer, "jumpToApp", strlen("jumpToApp")) == 0) {
                        const char* msg = "\r\n[INFO] Jumping to application...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        osDelay(100);
                        // fuse_clear(); // Implement fuse_clear() if needed
                        NVIC_SystemReset();
                    }

                     if(strncasecmp(log_buffer, "SET_UART_COMMAND_MODE", strlen("SET_UART_COMMAND_MODE")) == 0) {
                        const char* msg = "\r\n[INFO] Setting UART to COMMAND mode...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        osDelay(100);
                        data_transport_set_mode(APP_TRANSPORT_MODE_COMMAND);
                     }

                    if (strncasecmp(log_buffer, "restart", strlen("restart")) == 0) {
                        const char* msg = "\r\n[INFO] Restarting Controller...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        osDelay(100);
                        NVIC_SystemReset();
                    }

                    if (strncasecmp(log_buffer, "wifiBootloader", strlen("wifiBootloader")) == 0) {
                        const char* msg = "\r\n[INFO] Setting Wi-Fi module to bootloader mode...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                        if (wifi_enter_bootloader_mode()) {
                            const char* success_msg = "[INFO] Wi-Fi module is now in bootloader mode.\r\n";
                            const char* instruction = "[INFO] Module ready for UART firmware flashing.\r\n";
                            const char* exit_msg = "[INFO] Use 'wifiExitBootloader' to exit bootloader mode.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                            HAL_UART_Transmit(&huart1, (uint8_t*)instruction, strlen(instruction), HAL_MAX_DELAY);
                            HAL_UART_Transmit(&huart1, (uint8_t*)exit_msg, strlen(exit_msg), HAL_MAX_DELAY);
                        } else {
                            const char* error_msg = "[ERROR] Failed to enter Wi-Fi bootloader mode.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "wifiExitBootloader", strlen("wifiExitBootloader")) == 0) {
                        const char* msg = "\r\n[INFO] Exiting Wi-Fi bootloader mode...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                        if (wifi_exit_bootloader_mode()) {
                            const char* success_msg = "[INFO] Wi-Fi module reset and returned to normal operation.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                        } else {
                            const char* error_msg = "[ERROR] Failed to exit Wi-Fi bootloader mode.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                        }
                    }

                    // if (strncasecmp(log_buffer, "wifiEnable", strlen("wifiEnable")) == 0) {
                    //     const char* msg = "\r\n[INFO] Enabling Wi-Fi module for normal operation...\r\n";
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                    //     if (wifi_enable()) {
                    //         const char* success_msg = "[INFO] Wi-Fi module enabled (chip_en high, boot low).\r\n";
                    //         const char* ready_msg = "[INFO] Module ready for normal Wi-Fi operation.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)ready_msg, strlen(ready_msg), HAL_MAX_DELAY);
                    //     } else {
                    //         const char* error_msg = "[ERROR] Failed to enable Wi-Fi module.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                    //     }
                    // }

                    // if (strncasecmp(log_buffer, "wifiDebug", strlen("wifiDebug")) == 0) {
                    //     const char* msg = "\r\n[INFO] Wi-Fi Pin Status:\r\n";
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                    //     // Read and display current pin states
                    //     GPIO_PinState pwr_state = HAL_GPIO_ReadPin(WIFI_PWREN_GPIO_Port, WIFI_PWREN_Pin);
                    //     GPIO_PinState en_state = HAL_GPIO_ReadPin(WIFI_EN_GPIO_Port, WIFI_EN_Pin);
                    //     GPIO_PinState boot_state = HAL_GPIO_ReadPin(WIFI_WAKE_GPIO_Port, WIFI_WAKE_Pin);
                    //     GPIO_PinState reset_state = HAL_GPIO_ReadPin(WIFI_RESET_GPIO_Port, WIFI_RESET_Pin);
                    //     GPIO_PinState rdy_state = HAL_GPIO_ReadPin(WIFI_IRQ_GPIO_Port, WIFI_IRQ_Pin);
                        
                    //     char debug_msg[256];
                    //     snprintf(debug_msg, sizeof(debug_msg), 
                    //         "[DEBUG] PWR_EN: %s, EN: %s, BOOT: %s, RESET: %s, RDY: %s\r\n",
                    //         pwr_state ? "HIGH" : "LOW",
                    //         en_state ? "HIGH" : "LOW", 
                    //         boot_state ? "HIGH" : "LOW",
                    //         reset_state ? "HIGH" : "LOW",
                    //         rdy_state ? "HIGH" : "LOW");
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)debug_msg, strlen(debug_msg), HAL_MAX_DELAY);
                    // }

                    if (strncasecmp(log_buffer, "spiTest", strlen("spiTest")) == 0) {
                        const char* msg = "\r\n[INFO] Running SPI4 hardware test...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                        SpiTestResult_t result = test_spi_basic();
                        if (result == SPI_TEST_PASSED) {
                            const char* success_msg = "[INFO] SPI4 test PASSED! Hardware is working correctly.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                        } else {
                            const char* error_msg = "[ERROR] SPI4 test FAILED! Check hardware configuration.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                        }
                    }

                    // if (strncasecmp(log_buffer, "tcpInit", strlen("tcpInit")) == 0) {
                    //     const char* msg = "\r\n[INFO] Initializing TCP client system...\r\n";
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                    //     TCP_ClientStatus_t status = TCP_Client_Init();
                    //     if (status == TCP_CLIENT_OK) {
                    //         const char* success_msg = "[INFO] TCP client system initialized successfully.\r\n";
                    //         const char* next_msg = "[INFO] Use 'tcpConnect' to connect to Wi-Fi.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)next_msg, strlen(next_msg), HAL_MAX_DELAY);
                    //     } else {
                    //         const char* error_msg = "[ERROR] Failed to initialize TCP client system.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                    //     }
                    // }

                    // if (strncasecmp(log_buffer, "tcpConnect", strlen("tcpConnect")) == 0) {
                    //     const char* msg = "\r\n[INFO] Connecting to Wi-Fi...\r\n";
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                    //     TCP_ClientConfig_t config = {
                    //         .ssid = "MY_WIFI_SSID",
                    //         .password = "MY_WIFI_PASSWORD", 
                    //         .server_url = "tcpbin.com",
                    //         .server_port = 4242,
                    //         .timeout_ms = 30000
                    //     };
                        
                    //     TCP_ClientStatus_t status = TCP_Client_ConnectWiFi(&config);
                    //     if (status == TCP_CLIENT_OK) {
                    //         const char* success_msg = "[INFO] Connected to Wi-Fi successfully.\r\n";
                    //         const char* test_msg = "[INFO] Use 'tcpTest' to run echo test.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)test_msg, strlen(test_msg), HAL_MAX_DELAY);
                    //     } else {
                    //         const char* error_msg = "[ERROR] Failed to connect to Wi-Fi.\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                    //     }
                    // }

                    // if (strncasecmp(log_buffer, "tcpTest", strlen("tcpTest")) == 0) {
                    //     const char* msg = "\r\n[INFO] Running TCP echo test...\r\n";
                    //     HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        
                    //     TCP_ClientStatus_t status = TCP_Client_EchoTest("tcpbin.com", 4242, 1000);
                    //     if (status == TCP_CLIENT_OK) {
                    //         const char* success_msg = "[INFO] TCP echo test passed!\r\n";
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                    //     } else {
                    //         char error_msg[128];
                    //         snprintf(error_msg, sizeof(error_msg), "[ERROR] TCP echo test failed (status: %d).\r\n", status);
                    //         HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                    //     }
                    // }

                    if (strncasecmp(log_buffer, "jumpToFilesystem", strlen("jumpToFilesystem")) == 0) {
                        const char* msg = "\r\n[INFO] Starting File System...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        data_transport_set_mode(APP_TRANSPORT_MODE_FILESYSTEM_COMMAND);

                    }

                    if (strncasecmp(log_buffer, "exitFilesystem", strlen("exitFilesystem")) == 0) {
                        const char* msg = "\r\n[INFO] Exiting filesystem mode, returning to shell...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        data_transport_set_mode(APP_TRANSPORT_MODE_CONSOLE);
                    }
                    if (strncasecmp(log_buffer, "GETTIME", strlen("GETTIME")) == 0) {
                        const char* timeStr = rtc_get_time_str();
                        const char* prefix = "\r\n[RTC] Time: ";
                        HAL_UART_Transmit(&huart1, (uint8_t*)prefix, strlen(prefix), HAL_MAX_DELAY);
                        HAL_UART_Transmit(&huart1, (uint8_t*)timeStr, strlen(timeStr), HAL_MAX_DELAY);
                        HAL_UART_Transmit(&huart1, (uint8_t*)"\r\n", 2, HAL_MAX_DELAY);
                    }

                    if (strncasecmp(log_buffer, "SETTIME:", 8) == 0) {
                        const char* timeStr = log_buffer + 8;
                        int y, M, d, H, m, s;

                        if (sscanf(timeStr, "%d-%d-%dT%d:%d:%d", &y, &M, &d, &H, &m, &s) == 6) {
                             rtc_set_date(1, M, d, y - 2000);
                            rtc_set_time(H, m, s);
                            const char* msg = "\r\n[RTC] Time updated.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = "\r\n[RTC] Invalid format. Use YYYY-MM-DDTHH:MM:SS\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "SHOWLOG", strlen("SHOWLOG")) == 0) {
                        uart_print_current_log();
                    }

                    if (strncasecmp(log_buffer, "LISTLOGS", strlen("LISTLOGS")) == 0) {
                        uart_list_log_files();
                    }

                    if (strncasecmp(log_buffer, "READLOG:", 8) == 0) {
                        const char* filename = log_buffer + 8;
                        // Trim whitespace
                        while (*filename == ' ') filename++;
                        if (strlen(filename) > 0) {
                            uart_print_log_file(filename);
                        } else {
                            const char* err = "\r\n[ERROR] Usage: READLOG:filename.log\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "FORMATLOGDISK", strlen("FORMATLOGDISK")) == 0) {
                        const char* msg = "\r\n[INFO] FORMATTING LOG AREA...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        // Delete all .log files
                        char log_files[SPI_FLASH_MAX_FILES][SPI_FLASH_MAX_FILE_NAME];
                        int log_count = log_list_files(log_files, SPI_FLASH_MAX_FILES);
                        for (int i = 0; i < log_count; i++) {
                            ffs_delete(log_files[i]);
                        }
                        msg = "\r\n[INFO] LOG FORMAT DONE - All log files deleted\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                    }

                    if (strncasecmp(log_buffer, "FORMATDISK", strlen("FORMATDISK")) == 0) {

                        LOG_WARN("[FS_FORMAT] Format command received - this will erase all files!");
                        // Save erase counts to RAM before format
                        bool erase_counts_saved = ffs_incr_save_erase_counts();
                        if (erase_counts_saved) {
                            LOG_INFO("[FS_FORMAT] Erase counts saved to RAM for preservation");
                        } else {
                            LOG_WARN("[FS_FORMAT] Could not save erase counts - wear leveling data will be lost");
                        }
                        
                        // Format the filesystem
                        int result = ffs_format();
                        
                        if (result == 0) {
                            // Restore erase counts from RAM after format
                            if (erase_counts_saved && ffs_restore_erase_counts()) {
                                LOG_INFO("[FS_FORMAT] Erase counts restored - wear leveling data preserved");
                            } else if (erase_counts_saved) {
                                LOG_WARN("[FS_FORMAT] Could not restore erase counts");
                            } else {
                                // Feedback if erase counts were not saved at all
                                const char* warn_msg = "\r\n[WARN] Erase counts were not saved, wear leveling data lost\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)warn_msg, strlen(warn_msg), HAL_MAX_DELAY);
                
                            }
                            
                            // Free saved memory
                            ffs_block_alloc_save();
                            ffs_serialize_table();
                            ffs_free_saved_erase_counts();
                            
                            // Try to remount after format
                            if (ffs_mount(&spi_flash_fs_config)) {
                                LOG_INFO("[FS_FORMAT] Format completed successfully");
                            } else {
            
                                LOG_WARN("[FS_FORMAT] Format completed but remount failed");
                            }
                            // Free saved memory even if format failed
                            ffs_free_saved_erase_counts();
                        }

                    }

                    if (strncasecmp(log_buffer, "DUMPBLOCKS", strlen("DUMPBLOCKS")) == 0) {
                        const char* msg = "\r\n[INFO] FlashFs Block Status:\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        ffs_dump_blocks();
                    }

                    if (strncasecmp(log_buffer, "GETBLOCK:", strlen("GETBLOCK:")) == 0) {
                        const char* block_str = log_buffer + strlen("GETBLOCK:");
                        while (*block_str == ' ') block_str++;  // Skip leading spaces

                        // Parse block number
                        char* endptr;
                        long block_num = strtol(block_str, &endptr, 10);

                        if (endptr == block_str || block_num < 0) {
                            const char* err = "\r\n[ERROR] Usage: GETBLOCK:<block_number>\r\n"
                                            "Example: GETBLOCK:0\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            ffs_get_block_info((uint32_t)block_num);
                        }
                    }

                    if (strncasecmp(log_buffer, "RESET_ERASE_COUNTS", strlen("RESET_ERASE_COUNTS")) == 0) {
                        LOG_WARN("[ERASE_COUNTS] Resetting all erase counts to zero - WARNING: wear leveling history will be lost!");

                        if (ffs_reset_erase_counts()) {
                            LOG_INFO("[ERASE_COUNTS] Successfully reset all erase counts to zero");
                        } else {
                            LOG_ERROR("[ERASE_COUNTS] Failed to reset erase counts");
                        }
                    }

                    if (strncasecmp(log_buffer, "DEBUGMOUNT", strlen("DEBUGMOUNT")) == 0) {
                        const char* msg = "\r\n[INFO] Testing filesystem mount status...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

                        ffs_config = spi_flash_fs_config;
                        bool mount_result = ffs_mount(&spi_flash_fs_config);

                        char debug_msg[128];
                        snprintf(debug_msg, sizeof(debug_msg), "[DEBUG] Mount result: %s\r\n",
                                mount_result ? "SUCCESS" : "FAILED");
                        HAL_UART_Transmit(&huart1, (uint8_t*)debug_msg, strlen(debug_msg), HAL_MAX_DELAY);
                    }

                    if (strncasecmp(log_buffer, "LISTFILES", strlen("LISTFILES")) == 0) {
                        const char* msg = "\r\n[INFO] Listing all files...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

                        ffs_config = spi_flash_fs_config;
                        if (!ffs_mount(&spi_flash_fs_config)) {
                            const char* err = "\r\n[ERROR] Failed to mount filesystem\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            ffs_file_info_t files[20];
                            int file_count = ffs_list_files(files, FFS_MAX_FILES);

                            if (file_count == 0) {
                                const char* empty = "\r\n[INFO] No files found\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)empty, strlen(empty), HAL_MAX_DELAY);
                            } else {
                                for (int i = 0; i < file_count; i++) {
                                    char file_info[128];
                                    bool is_log_file = (strstr(files[i].name, ".log") != NULL);
                                    uint32_t display_size = files[i].size;

                                    // For log files, always recover actual size from flash
                                    // (file_table size may be stale/not persisted)
                                    if (is_log_file) {
                                        int temp_id = ffs_open_log(files[i].name);
                                        if (temp_id >= 0) {
                                            display_size = file_table[temp_id].size;
                                        }
                                    }

                                    snprintf(file_info, sizeof(file_info), "\r\n[FILE] %s (%lu bytes)\r\n",
                                             files[i].name, (unsigned long)display_size);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)file_info, strlen(file_info), HAL_MAX_DELAY);
                                }

                            }
                        }
                    }
    
                    if (strncasecmp(log_buffer, "READFILE:", 9) == 0) {
                        const char* filename = log_buffer + 9;
                        while (*filename == ' ') filename++;

                        if (strlen(filename) == 0) {
                            const char* err = "\r\n[ERROR] Usage: READFILE:filename\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            char header[128];
                            snprintf(header, sizeof(header), "\r\n[INFO] Reading file: %s\r\n", filename);
                            HAL_UART_Transmit(&huart1, (uint8_t*)header, strlen(header), HAL_MAX_DELAY);

                            ffs_config = spi_flash_fs_config;
                            if (!ffs_mount(&spi_flash_fs_config)) {
                                const char* err = "\r\n[ERROR] Failed to mount filesystem\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            } else {
                                int file_id = ffs_open(filename);
                                if (file_id < 0) {
                                    char err_msg[128];
                                    snprintf(err_msg, sizeof(err_msg), "\r\n[ERROR] Cannot open file: %s\r\n", filename);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), HAL_MAX_DELAY);
                                } else {
                                    char line_buffer[256];
                                    int line_count = 0;

                                    while (ffs_read_line(file_id, line_buffer, sizeof(line_buffer)) > 0 && line_count < 50) {
                                        char numbered_line[300];
                                        snprintf(numbered_line, sizeof(numbered_line), "%04d: %s\r\n", ++line_count, line_buffer);
                                        HAL_UART_Transmit(&huart1, (uint8_t*)numbered_line, strlen(numbered_line), HAL_MAX_DELAY);
                                    }

                                    if (line_count >= 50) {
                                        const char* truncated = "\r\n[INFO] Output truncated at 50 lines...\r\n";
                                        HAL_UART_Transmit(&huart1, (uint8_t*)truncated, strlen(truncated), HAL_MAX_DELAY);
                                    }

                                    char footer[64];
                                    snprintf(footer, sizeof(footer), "\r\n[INFO] End of file (%d lines)\r\n", line_count);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)footer, strlen(footer), HAL_MAX_DELAY);
                                }
                            }
                        }
                    }

                    if (strncasecmp(log_buffer, "DELETEFILE:", 11) == 0) {
                        const char* filename = log_buffer + 11;
                        while (*filename == ' ') filename++;

                        if (strlen(filename) == 0) {
                            const char* err = "\r\n[ERROR] Usage: DELETEFILE:filename\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            char header[128];
                            snprintf(header, sizeof(header), "\r\n[INFO] Deleting file: %s\r\n", filename);
                            HAL_UART_Transmit(&huart1, (uint8_t*)header, strlen(header), HAL_MAX_DELAY);

                            ffs_config = spi_flash_fs_config;
                            if (!ffs_mount(&spi_flash_fs_config)) {
                                const char* err = "\r\n[ERROR] Failed to mount filesystem\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            } else {
                                if (!ffs_file_exists(filename)) {
                                    char err_msg[128];
                                    snprintf(err_msg, sizeof(err_msg), "\r\n[ERROR] File not found: %s\r\n", filename);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), HAL_MAX_DELAY);
                                } else {
                                    int result = ffs_delete(filename);
                                    if (result == 0) {
                                        char success_msg[128];
                                        snprintf(success_msg, sizeof(success_msg), "\r\n[INFO] File deleted successfully: %s\r\n", filename);
                                        HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                                    } else {
                                        char err_msg[128];
                                        snprintf(err_msg, sizeof(err_msg), "\r\n[ERROR] Failed to delete file: %s\r\n", filename);
                                        HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), HAL_MAX_DELAY);
                                    }
                                }
                            }
                        }
                    }

                    if (strncasecmp(log_buffer, "SEND_TCP:", 5) == 0) {
                        const char* message = log_buffer + 5;
                        while (*message == ' ') message++;  // Skip leading spaces

                        if (strlen(message) == 0) {
                            const char* err = "\r\n[ERROR] Usage: SEND_TCP:your message here\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else if (strlen(message) >= TCP_MSG_MAX_LEN) {
                            const char* err = "\r\n[ERROR] Message too long (max 255 chars)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            // Send message to TCP client task via queue
                            char tcp_message[TCP_MSG_MAX_LEN];
                            strncpy(tcp_message, message, TCP_MSG_MAX_LEN - 1);
                            tcp_message[TCP_MSG_MAX_LEN - 1] = '\0';

                            if (tcpClientQueue != NULL) {
                                if (xQueueSend(tcpClientQueue, tcp_message, pdMS_TO_TICKS(100)) == pdTRUE) {
                                    char success_msg[128];
                                    snprintf(success_msg, sizeof(success_msg), "\r\n[INFO] Queued message for TCP transmission: %s\r\n", message);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                                } else {
                                    const char* err = "\r\n[ERROR] Failed to queue message (queue full)\r\n";
                                    HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                                }
                            } else {
                                const char* err = "\r\n[ERROR] TCP client not initialized\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            }
                        }
                    }

                    if (strncasecmp(log_buffer, "tcpServerStart", strlen("tcpServerStart")) == 0) {
                        const char* msg = "\r\n[INFO] Starting TCP server...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

                        if (wifi_tcp_server_init(0) == 0 && wifi_tcp_server_start() == 0) {
                            const char* success_msg = "[INFO] TCP server started successfully on port 8080\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                        } else {
                            const char* error_msg = "[ERROR] Failed to start TCP server\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "tcpServerStop", strlen("tcpServerStop")) == 0) {
                        const char* msg = "\r\n[INFO] Stopping TCP server...\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

                        if (wifi_tcp_server_stop() == 0) {
                            const char* success_msg = "[INFO] TCP server stopped successfully\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                        } else {
                            const char* error_msg = "[ERROR] Failed to stop TCP server\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "tcpServerStatus", strlen("tcpServerStatus")) == 0) {
                        const char* msg = "\r\n[INFO] TCP server status:\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

                        tcp_server_state_t state;
                        uint32_t active_clients, total_connections;
                        wifi_tcp_server_get_status(&state, &active_clients, &total_connections);

                        const char* state_str = (state == TCP_SERVER_STOPPED) ? "STOPPED" :
                                              (state == TCP_SERVER_STARTING) ? "STARTING" :
                                              (state == TCP_SERVER_RUNNING) ? "RUNNING" : "ERROR";

                        char status_msg[256];
                        snprintf(status_msg, sizeof(status_msg),
                                "[STATUS] State: %s, Active Clients: %lu, Total Connections: %lu\r\n",
                                state_str, active_clients, total_connections);
                        HAL_UART_Transmit(&huart1, (uint8_t*)status_msg, strlen(status_msg), HAL_MAX_DELAY);
                    }

                    if (strncasecmp(log_buffer, "BROADCAST_TCP:", strlen("BROADCAST_TCP:")) == 0) {
                        const char* message = log_buffer + strlen("BROADCAST_TCP:");
                        while (*message == ' ') message++;  // Skip leading spaces

                        if (strlen(message) == 0) {
                            const char* err = "\r\n[ERROR] Usage: BROADCAST_TCP:your message here\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            // Broadcast message to all connected clients
                            int32_t clients_sent = wifi_tcp_server_broadcast((const uint8_t*)message, strlen(message));

                            if (clients_sent >= 0) {
                                char success_msg[128];
                                snprintf(success_msg, sizeof(success_msg),
                                        "\r\n[INFO] Broadcasted to %ld clients: %s\r\n", clients_sent, message);
                                HAL_UART_Transmit(&huart1, (uint8_t*)success_msg, strlen(success_msg), HAL_MAX_DELAY);
                            } else {
                                const char* error_msg = "\r\n[ERROR] Failed to broadcast message\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)error_msg, strlen(error_msg), HAL_MAX_DELAY);
                            }
                        }
                    }

                    // WiFi Credential Management Commands
                    if (strncasecmp(log_buffer, "WIFI_SHOW", strlen("WIFI_SHOW")) == 0) {
                        if (g_userConfig && userconfig_has_wifi_credentials(g_userConfig)) {
                            char wifi_msg[256];
                            snprintf(wifi_msg, sizeof(wifi_msg),
                                    "\r\n=== Stored WiFi Credentials ===\r\n"
                                    "SSID: %s\r\n"
                                    "Password: %s\r\n"
                                    "Auto-Connect: %s\r\n",
                                    userconfig_get_wifi_ssid(g_userConfig),
                                    userconfig_get_wifi_password(g_userConfig),
                                    userconfig_get_wifi_autoconnect(g_userConfig) ? "Enabled" : "Disabled");
                            HAL_UART_Transmit(&huart1, (uint8_t*)wifi_msg, strlen(wifi_msg), HAL_MAX_DELAY);
                        } else {
                            const char* msg = "\r\n[INFO] No WiFi credentials stored in NVRAM\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_SET_SSID:", strlen("WIFI_SET_SSID:")) == 0) {
                        const char* ssid = log_buffer + strlen("WIFI_SET_SSID:");
                        while (*ssid == ' ') ssid++;  // Skip leading spaces

                        if (strlen(ssid) == 0 || strlen(ssid) > 32) {
                            const char* err = "\r\n[ERROR] Usage: WIFI_SET_SSID:YourNetworkName (max 32 chars)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else if (g_userConfig && userconfig_set_wifi_ssid(g_userConfig, ssid)) {
                            char msg[128];
                            snprintf(msg, sizeof(msg), "\r\n[INFO] WiFi SSID set to: %s (not saved to NVRAM yet)\r\n", ssid);
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = "\r\n[ERROR] Failed to set WiFi SSID\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_SET_PASSWORD:", strlen("WIFI_SET_PASSWORD:")) == 0) {
                        const char* password = log_buffer + strlen("WIFI_SET_PASSWORD:");
                        while (*password == ' ') password++;  // Skip leading spaces

                        if (strlen(password) == 0 || strlen(password) > 64) {
                            const char* err = "\r\n[ERROR] Usage: WIFI_SET_PASSWORD:YourPassword (max 64 chars)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else if (g_userConfig && userconfig_set_wifi_password(g_userConfig, password)) {
                            const char* msg = "\r\n[INFO] WiFi password set (not saved to NVRAM yet)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = "\r\n[ERROR] Failed to set WiFi password\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_SET_AUTOCONNECT:", strlen("WIFI_SET_AUTOCONNECT:")) == 0) {
                        const char* value = log_buffer + strlen("WIFI_SET_AUTOCONNECT:");
                        while (*value == ' ') value++;  // Skip leading spaces

                        if (g_userConfig) {
                            if (strcasecmp(value, "on") == 0 || strcasecmp(value, "1") == 0 || strcasecmp(value, "true") == 0) {
                                userconfig_set_wifi_autoconnect(g_userConfig, true);
                                const char* msg = "\r\n[INFO] WiFi auto-connect enabled (not saved to NVRAM yet)\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                            } else if (strcasecmp(value, "off") == 0 || strcasecmp(value, "0") == 0 || strcasecmp(value, "false") == 0) {
                                userconfig_set_wifi_autoconnect(g_userConfig, false);
                                const char* msg = "\r\n[INFO] WiFi auto-connect disabled (not saved to NVRAM yet)\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                            } else {
                                const char* err = "\r\n[ERROR] Usage: WIFI_SET_AUTOCONNECT:on|off\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            }
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_SAVE", strlen("WIFI_SAVE")) == 0) {
                        if (g_userConfig && userconfig_save_wifi(g_userConfig)) {
                            const char* msg = "\r\n[SUCCESS] WiFi credentials saved to NVRAM\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = "\r\n[ERROR] Failed to save WiFi credentials to NVRAM\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_LOAD", strlen("WIFI_LOAD")) == 0) {
                        if (g_userConfig && userconfig_load_wifi(g_userConfig)) {
                            char msg[256];
                            snprintf(msg, sizeof(msg),
                                    "\r\n[SUCCESS] WiFi credentials loaded from NVRAM\r\n"
                                    "SSID: %s\r\n",
                                    userconfig_get_wifi_ssid(g_userConfig));
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = "\r\n[ERROR] Failed to load WiFi credentials from NVRAM (or no valid credentials stored)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if (strncasecmp(log_buffer, "WIFI_RESET", strlen("WIFI_RESET")) == 0) {
                        if (g_userConfig) {
                            userconfig_reset_wifi(g_userConfig);
                            const char* msg = "\r\n[INFO] WiFi credentials reset to defaults (empty credentials)\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "TEST_PPM", strlen("TEST_PPM")) == 0) {
                        uint32_t timeout_ms = 5000; // Default 5 seconds

                        // Check if timeout parameter provided (e.g., "TEST_PPM 60000")
                        if (log_pos > 9 && log_buffer[8] == ' ') {
                            const char* timeout_str = log_buffer + 9;
                            int parsed_timeout = atoi(timeout_str);
                            if (parsed_timeout > 0 && parsed_timeout <= 300000) { // Max 5 minutes
                                timeout_ms = (uint32_t)parsed_timeout;
                            } else {
                                const char* err = "\r\n[ERROR] Invalid timeout. Use 1-300000 ms (max 5 minutes)\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                                timeout_ms = 5000; // Fallback to default
                            }
                        }

                        char msg[128];
                        snprintf(msg, sizeof(msg), "\r\n[INFO] Starting PPM signal test (timeout: %dms)...\r\n", timeout_ms);
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        test_ppm(timeout_ms);
                    }

                    if(strncasecmp(log_buffer, "TEST_BATMON", strlen("TEST_BATMON")) == 0) {
                        uint32_t duration_ms = 10000; // Default 10 seconds

                        // Check if duration parameter provided (e.g., "TEST_BATMON 30000")
                        if (log_pos > 12 && log_buffer[11] == ' ') {
                            const char* duration_str = log_buffer + 12;
                            int parsed_duration = atoi(duration_str);
                            if (parsed_duration > 0 && parsed_duration <= 300000) { // Max 5 minutes
                                duration_ms = (uint32_t)parsed_duration;
                            } else {
                                const char* err = "\r\n[ERROR] Invalid duration. Use 1-300000 ms (max 5 minutes)\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                                duration_ms = 10000; // Fallback to default
                            }
                        }

                        char msg[128];
                        snprintf(msg, sizeof(msg), "\r\n[INFO] Starting Battery Monitor test (duration: %dms)...\r\n", duration_ms);
                        HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        test_batteryMonitor(duration_ms);
                    }

                    if(strncasecmp(log_buffer, "BATMON_CALIBRATE", strlen("BATMON_CALIBRATE")) == 0) {
                        
                        if (!batmon_is_initialized()) {
                            const char* err = "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else if (!batmon_is_running()) {
                            const char* err = "\r\n[ERROR] BatteryMonitor not running! Start DMA first.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            const char* warn =
                                "\r\n========================================\r\n"
                                "STARTING CALIBRATION\r\n"
                                "========================================\r\n"
                                "CRITICAL: Ensure NO current flowing!\r\n"
                                "Disconnect all loads from battery.\r\n"
                                "Calibration starts in 3 seconds...\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)warn, strlen(warn), HAL_MAX_DELAY);
                            HAL_Delay(3000);

                            if (batmon_calibrate(100)) {
                                const userconfig_batmon_t* cal = batmon_get_calibration();
                                char msg[512];
                                snprintf(msg, sizeof(msg),
                                        "\r\n[SUCCESS] Calibration complete!\r\n"
                                        "  VREF: %.4fV\r\n"
                                        "  Zero (raw): %.4fV\r\n"
                                        "  Zero (buffered): %.4fV\r\n"
                                        "  Sensitivity: %.3fV/A\r\n"
                                        "Calibration saved to NVRAM.\r\n",
                                        cal->vref, cal->zero_current_raw, cal->zero_current_buffered, cal->sensitivity_raw);
                                HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                            } else {
                                const char* err = "\r\n[ERROR] Calibration failed!\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            }
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_STATUS", strlen("BATMON_STATUS")) == 0) {
                        
                        if (!batmon_is_initialized()) {
                            const char* err = "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            char msg[1024];
                            int offset = 0;
                            offset += snprintf(msg + offset, sizeof(msg) - offset,
                                    "\r\n========================================\r\n"
                                    "BATTERY MONITOR STATUS\r\n"
                                    "========================================\r\n"
                                    "Running: %s\r\n"
                                    "Calibrated: %s\r\n",
                                    batmon_is_running() ? "YES" : "NO",
                                    batmon_is_calibrated() ? "YES" : "NO");

                            if (batmon_is_calibrated()) {
                                const userconfig_batmon_t* cal = batmon_get_calibration();
                                
                                

                                offset += snprintf(msg + offset, sizeof(msg) - offset,
                                        "VREF: %.4fV\r\n"
                                        "Zero (raw): %.4fV\r\n"
                                        "Zero (buffered): %.4fV\r\n"
                                        "Sensitivity: %.3fV/A\r\n"
                                        "Polarity: %s\r\n"
                                        "Channels: Raw=%s, Buffered=%s\r\n"
                                        "Calculation uses: %s\r\n"
                                        "----------------------------------------\r\n",
                                        cal->vref, cal->zero_current_raw, cal->zero_current_buffered, cal->sensitivity_raw,
                                        cal->invert_polarity ? "INVERTED (GND/return)" : "NORMAL (VCC+)",
                                        batmon_is_raw_channel_enabled() ? "ENABLED" : "DISABLED",
                                        batmon_is_buffered_channel_enabled() ? "ENABLED" : "DISABLED",
                                        (batmon_is_raw_channel_enabled() && batmon_is_buffered_channel_enabled()) ? "BOTH channels" :
                                        batmon_is_raw_channel_enabled() ? "RAW channel only" :
                                        batmon_is_buffered_channel_enabled() ? "BUFFERED channel only" : "NO channels (ERROR)");

                                // Get current readings
                                float v_raw = batmon_get_voltage_raw();
                                float v_buf = batmon_get_voltage_buffered();
                                float v_avg = (v_raw + v_buf) / 2.0f;
                                float delta_v = v_avg - cal->zero_current_raw;  // Voltage deviation from zero

                                offset += snprintf(msg + offset, sizeof(msg) - offset,
                                        "Current Readings:\r\n"
                                        "  ADC Raw:      %4d (%.4fV) -> %.3fA\r\n"
                                        "  ADC Buffered: %4d (%.4fV) -> %.3fA\r\n"
                                        "  Average:           %.4fV -> %.3fA\r\n"
                                        "  Voltage delta: %.4fV from zero (%.4fV)\r\n"
                                        "----------------------------------------\r\n"
                                        "Statistics:\r\n"
                                        "  Min: %.3fA\r\n"
                                        "  Max: %.3fA\r\n"
                                        "  Avg: %.3fA\r\n"
                                        "  Samples: %lu\r\n"
                                        "  DMA callbacks: %lu\r\n",
                                        batmon_get_adc_raw(), v_raw, batmon_get_current(),
                                        batmon_get_adc_buffered(), v_buf, batmon_get_current(),
                                        v_avg, batmon_get_current(),
                                        delta_v, cal->zero_current_raw,
                                        batmon_get_stat_min(), batmon_get_stat_max(), batmon_get_stat_avg(),
                                        batmon_get_stat_samples(), batmon_get_stat_dma_callbacks());
                            }

                            offset += snprintf(msg + offset, sizeof(msg) - offset,
                                    "========================================\r\n");

                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_RESET", strlen("BATMON_RESET")) == 0) {

                        if (!batmon_is_initialized()) {
                            const char* err = "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            batmon_erase_calibration();
                            const char* msg = "\r\n[INFO] Calibration reset. Driver will return 0.0A until re-calibrated.\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_SET_POLARITY", strlen("BATMON_SET_POLARITY")) == 0) {
                        if (!batmon_is_initialized()) {
                            const char* err = "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else if (!batmon_is_calibrated()) {
                            const char* err = "\r\n[ERROR] Must calibrate first! Use BATMON_CALIBRATE\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        } else {
                            // Parse argument (0 or 1)
                            const char* arg = strchr(log_buffer, ' ');
                            if (arg) {
                                arg++;  // Skip space
                                uint8_t invert = (uint8_t)atoi(arg);
                                if (batmon_set_polarity(invert)) {
                                    char msg[256];
                                    snprintf(msg, sizeof(msg),
                                            "\r\n[INFO] Polarity set to: %s\r\n"
                                            "[INFO] Current readings will now be %s\r\n"
                                            "[INFO] Restart monitoring task or wait for next sample\r\n",
                                            invert ? "INVERTED (sensor on GND/return)" : "NORMAL (sensor on VCC+)",
                                            invert ? "POSITIVE (absolute value)" : "NORMAL (can be positive/negative)");
                                    HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                                } else {
                                    const char* err = "\r\n[ERROR] Failed to set polarity!\r\n";
                                    HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                                }
                            } else {
                                const char* usage =
                                    "\r\n[ERROR] Usage: BATMON_SET_POLARITY <0|1>\r\n"
                                    "  0 = NORMAL (sensor on VCC+ path)\r\n"
                                    "  1 = INVERTED (sensor on GND/return path)\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)usage, strlen(usage), HAL_MAX_DELAY);
                            }
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_SET_VREF", strlen("BATMON_SET_VREF")) == 0) {
                        if (batmon_is_initialized()) {
                            const char* arg = strchr(log_buffer, ' ');

                            if(arg) {
                                arg++;  // Skip the space character

                                // Copy argument to clean buffer for atof
                                char vref_str[16];
                                memset(vref_str, 0, sizeof(vref_str));
                                strncpy(vref_str, arg, sizeof(vref_str) - 1);

                                // Parse voltage using atof
                                double vref = atof(vref_str);

                                if (vref < 2.5f || vref > 3.6f) {
                                    char msg[256];
                                    snprintf(msg, sizeof(msg),
                                            "\r\n[ERROR] Invalid voltage value: %.4fV\r\n"
                                            "[INFO] Usage: BATMON_SET_VREF <voltage>\r\n"
                                            "[INFO] Example: BATMON_SET_VREF 3.28\r\n"
                                            "[INFO] Valid range: 2.5V - 3.6V\r\n",
                                             vref);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                                } else if (batmon_set_vref((double)vref)) {
                                    char msg[256];
                                    snprintf(msg, sizeof(msg),
                                            "\r\n[SUCCESS] VREF updated to %.4fV\r\n"
                                            "[INFO] Saved to NVRAM. Current readings will now use this reference.\r\n",
                                            vref);
                                    HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                                } else {
                                    const char* err = "\r\n[ERROR] Failed to set VREF. Check logs for details.\r\n";
                                    HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                                }
                            } else {
                                const char* err = "\r\n[ERROR] Missing voltage value\r\n"
                                                 "[INFO] Usage: BATMON_SET_VREF <voltage>\r\n"
                                                 "[INFO] Example: BATMON_SET_VREF 3.28\r\n";
                                HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                            }
                        } else {
                            const char* err = "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_ENABLE_RAW", strlen("BATMON_ENABLE_RAW")) == 0) {
                        const char* arg = strchr(log_buffer, ' ');
                        if (arg && batmon_is_initialized()) {
                            arg++;
                            int enable = atoi(arg);
                            batmon_set_raw_channel_enabled(enable);

                            char msg[128];
                            snprintf(msg, sizeof(msg),
                                    "\r\n[INFO] Raw channel %s\r\n"
                                    "[INFO] Current calculation will use: %s\r\n",
                                    enable ? "ENABLED" : "DISABLED",
                                    (batmon_is_raw_channel_enabled() && batmon_is_buffered_channel_enabled()) ? "BOTH channels" :
                                    batmon_is_raw_channel_enabled() ? "RAW channel only" :
                                    batmon_is_buffered_channel_enabled() ? "BUFFERED channel only" : "NO channels (ERROR)");
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = batmon_is_initialized() ?
                                "\r\n[ERROR] Usage: BATMON_ENABLE_RAW <0|1>\r\n" :
                                "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "BATMON_ENABLE_BUFFERED", strlen("BATMON_ENABLE_BUFFERED")) == 0) {
                        const char* arg = strchr(log_buffer, ' ');
                        if (arg && batmon_is_initialized()) {
                            arg++;
                            int enable = atoi(arg);
                            batmon_set_buffered_channel_enabled(enable);

                            char msg[128];
                            snprintf(msg, sizeof(msg),
                                    "\r\n[INFO] Buffered channel %s\r\n"
                                    "[INFO] Current calculation will use: %s\r\n",
                                    enable ? "ENABLED" : "DISABLED",
                                    (batmon_is_raw_channel_enabled() && batmon_is_buffered_channel_enabled()) ? "BOTH channels" :
                                    batmon_is_raw_channel_enabled() ? "RAW channel only" :
                                    batmon_is_buffered_channel_enabled() ? "BUFFERED channel only" : "NO channels (ERROR)");
                            HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
                        } else {
                            const char* err = batmon_is_initialized() ?
                                "\r\n[ERROR] Usage: BATMON_ENABLE_BUFFERED <0|1>\r\n" :
                                "\r\n[ERROR] BatteryMonitor not initialized!\r\n";
                            HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
                        }
                    }

                    if(strncasecmp(log_buffer, "HELP", strlen("HELP")) == 0) {
                        const char* help_msg =
                            "\r\n=== AVAILABLE COMMANDS ===\r\n"
                            "SHOWLOG               - Display current log file\r\n"
                            "LISTLOGS             - List all log files\r\n"
                            "READLOG:filename.log  - Read specified log file\r\n"
                            "FORMATLOGDISK        - Format log storage area\r\n"
                            "FORMATDISK           - Format entire filesystem\r\n"
                            "DUMPBLOCKS           - Dump flash block status\r\n"
                            "GETBLOCK:<num>       - Get detailed block info with chain\r\n"
                            "RESET_ERASE_COUNTS   - Reset all block erase counts to zero\r\n"
                            "DEBUGMOUNT          - Test filesystem mount status\r\n"
                            "LISTFILES           - List all files in filesystem\r\n"
                            "READFILE:filename    - Read specified file\r\n"
                            "DELETEFILE:filename  - Delete specified file\r\n"
                            "SEND_TCP:message     - Send message via TCP client\r\n"
                            "tcpServerStart       - Start TCP server\r\n"
                            "tcpServerStop        - Stop TCP server\r\n"
                            "tcpServerStatus      - Get TCP server status\r\n"
                            "BROADCAST_TCP:message- Broadcast message to all TCP clients\r\n"
                            "WIFI_SHOW            - Show stored WiFi credentials\r\n"
                            "WIFI_SET_SSID:name   - Set WiFi SSID (max 32 chars)\r\n"
                            "WIFI_SET_PASSWORD:pw - Set WiFi password (max 64 chars)\r\n"
                            "WIFI_SET_AUTOCONNECT:on|off - Enable/disable auto-connect\r\n"
                            "WIFI_SAVE            - Save WiFi credentials to NVRAM\r\n"
                            "WIFI_LOAD            - Load WiFi credentials from NVRAM\r\n"
                            "WIFI_RESET           - Reset WiFi credentials to defaults\r\n"
                            "GETTIME              - Get current RTC time\r\n"
                            "SETTIME:YYYY-MM-DDTHH:MM:SS - Set RTC time\r\n"
                            "TEST_PPM [timeout]   - Test PPM decoder (timeout in ms, default: 5000)\r\n"
                            "spiTest              - Run SPI4 hardware test\r\n"
                            "jumpToFilesystem     - Enter filesystem mode\r\n"
                            "exitFilesystem      - Exit filesystem mode\r\n"
                            "TEST_BATMON [duration] - Test battery current monitor (duration in ms, default: 10000)\r\n"
                            "BATMON_CALIBRATE     - Calibrate battery current sensor (ensure 0A current!)\r\n"
                            "BATMON_STATUS        - Show battery monitor status and current readings\r\n"
                            "BATMON_SET_VREF <voltage> - Set ADC reference voltage (e.g., 3.28)\r\n"
                            "BATMON_SET_POLARITY <0|1> - Set polarity (0=VCC+, 1=GND/return)\r\n"
                            "BATMON_ENABLE_RAW <0|1> - Enable/disable raw channel in calculation\r\n"
                            "BATMON_ENABLE_BUFFERED <0|1> - Enable/disable buffered channel in calculation\r\n"
                            "BATMON_RESET         - Reset battery monitor calibration\r\n"
                            "HELP                 - Show this help message\r\n";
                        HAL_UART_Transmit(&huart1, (uint8_t*)help_msg, strlen(help_msg), HAL_MAX_DELAY);
                    }

                log_pos = 0;
                memset(log_buffer, 0, sizeof(log_buffer));
            }
            uart_send_string(prompt);
            break;

        case 0x7F: // DEL / Backspace
        case '\b':
            if (log_pos > 0) {
                log_pos--;
                log_buffer[log_pos] = '\0';
                uart_send_string("\b \b");
            }
            break;

        default:
            if (log_pos < sizeof(log_buffer) - 1 && byte >= 0x20 && byte <= 0x7E) {
                log_buffer[log_pos++] = byte;
                HAL_UART_Transmit(&huart1, &byte, 1, HAL_MAX_DELAY);  // Echo character
            }
            break;
    }
}

// =============================================================================
// LOG FILE DISPLAY FUNCTIONS
// =============================================================================

void uart_print_current_log(void) {
    const char* current_filename = log_get_current_filename();
    if (!current_filename || strlen(current_filename) == 0) {
        const char* err = "\r\n[ERROR] No current log file available\r\n";
        HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
        return;
    }

    char header[128];
    snprintf(header, sizeof(header), "\r\n=== CURRENT LOG FILE: %s ===\r\n", current_filename);
    HAL_UART_Transmit(&huart1, (uint8_t*)header, strlen(header), HAL_MAX_DELAY);
    
    uart_print_log_file(current_filename);
}

void uart_list_log_files(void) {
    char log_files[20][32];
    int log_count = log_list_files(log_files, 20);
    
    const char* header = "\r\n=== LOG FILES ===\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)header, strlen(header), HAL_MAX_DELAY);
    
    if (log_count == 0) {
        const char* no_files = "No log files found\r\n";
        HAL_UART_Transmit(&huart1, (uint8_t*)no_files, strlen(no_files), HAL_MAX_DELAY);
        return;
    }
    
    for (int i = 0; i < log_count; i++) {
        char file_info[64];
        snprintf(file_info, sizeof(file_info), "%d. %s\r\n", i + 1, log_files[i]);
        HAL_UART_Transmit(&huart1, (uint8_t*)file_info, strlen(file_info), HAL_MAX_DELAY);
    }
    
    const char* usage = "\r\nUsage: READLOG:filename.log\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)usage, strlen(usage), HAL_MAX_DELAY);
}

void uart_print_log_file(const char* filename) {
    if (!filename) {
        const char* err = "\r\n[ERROR] Invalid filename\r\n";
        HAL_UART_Transmit(&huart1, (uint8_t*)err, strlen(err), HAL_MAX_DELAY);
        return;
    }

    // Open the log file for reading
    int file_id = ffs_open(filename);
    if (file_id < 0) {
        char err_msg[128];
        snprintf(err_msg, sizeof(err_msg), "\r\n[ERROR] Cannot open log file: %s\r\n", filename);
        HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), HAL_MAX_DELAY);
        return;
    }
    
    // Print file header with size info
    uint32_t file_size = file_table[file_id].size;
    char file_header[128];
    snprintf(file_header, sizeof(file_header), "\r\n=== LOG FILE: %s (%lu bytes) ===\r\n", 
             filename, (unsigned long)file_size);
    HAL_UART_Transmit(&huart1, (uint8_t*)file_header, strlen(file_header), HAL_MAX_DELAY);
    
    ffs_seek(file_id, 0, FFS_SEEK_SET);
    
    char line_buffer[256];
    int line_count = 0;
    
    while (ffs_read_line(file_id, line_buffer, sizeof(line_buffer)) > 0) {

        char numbered_line[300];
        snprintf(numbered_line, sizeof(numbered_line), "%04d: %s\r\n", ++line_count, line_buffer);
        HAL_UART_Transmit(&huart1, (uint8_t*)numbered_line, strlen(numbered_line), HAL_MAX_DELAY);
        
        if (line_count >= 1000) {
            const char* truncated = "\r\n[INFO] Output truncated at 1000 lines...\r\n";
            HAL_UART_Transmit(&huart1, (uint8_t*)truncated, strlen(truncated), HAL_MAX_DELAY);
            break;
        }
    }
    
    char footer[64];
    snprintf(footer, sizeof(footer), "\r\n=== END OF LOG (%d lines) ===\r\n", line_count);
    HAL_UART_Transmit(&huart1, (uint8_t*)footer, strlen(footer), HAL_MAX_DELAY);
}

